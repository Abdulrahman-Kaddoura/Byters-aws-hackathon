# Copy to `.env` and fill in from the CDK stack outputs (see scripts/deploy.sh
# or scripts/deploy.ps1 on Windows, which write this file for you automatically).
# All four values are required — the frontend has no offline/demo mode and
# throws on startup if any are missing (see src/lib/config.ts).

VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
